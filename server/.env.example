PORT=5000
JWT_SECRET=dev_secret
JITSI_DOMAIN=jitsi.riot.im
MONGODB_URI=mongodb://<username>:<password>@<cluster-addresses>/triage-horizon?ssl=true&replicaSet=atlas-117mss-shard-0&authSource=admin&retryWrites=true&w=majority
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
# Live triage sends symptom text and limited clinical context to Groq.
USE_LIVE_LLM=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
